---
import PageLayout from '../../layouts/PageLayout.astro';
const base=import.meta.env.BASE_URL;
const items=[
['research','active research','Genomic Architecture Project','Local genealogies, TMRCA regimes and genomic heterogeneity in Steinernema carpocapsae.','genomic-architecture/','evolutionary genomics · coalescence · chromosomes'],
['building','in development','BIOATLAS','A digital atlas connecting biodiversity, evolution, geography and deep time.','bioatlas/','maps · phylogenies · natural history · interactive web'],
['building','concept build',"Darwin's Monsters",'Evolutionary stories about the remarkable forms and solutions generated by natural selection and history.','darwins-monsters/','science communication · species · storytelling'],
['','toolbench','Evolution Tools','Small open tools for evolutionary analysis, teaching and visualization.','evolution-tools/','CLI · web apps · reproducibility'],
['','experimental','Homogmos AI','Experiments connecting language models, biological knowledge and scientific workflows.','homogmos-ai/','LLMs · research interfaces · local AI'],
['','planned','Open Datasets','Curated datasets, derived tables and reproducible examples released alongside projects when possible.','open-datasets/','documentation · reuse · reproducibility']];
---
<PageLayout title="Projects" kicker="PROJECTS // current missions" lead="Research is only one output. Homogmos Lab also builds software, public resources and experimental science-communication projects.">
<section><div class="grid">{items.map(([cls,status,title,text,route,mini]) => <a class="card card-link" href={`${base}projects/${route}`}><span class={`status ${cls}`}>{status}</span><h3>{title}</h3><p>{text}</p><p class="mini">{mini}</p></a>)}</div></section>
</PageLayout>