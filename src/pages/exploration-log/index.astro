---
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
const base=import.meta.env.BASE_URL;
const entries=(await getCollection('explorationLog', ({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
---
<PageLayout title="Exploration Log" kicker="EXPLORATION LOG // research in motion" lead="Not a publication list. A record of questions changing shape: hypotheses, analyses, dead ends, tools and discoveries as the laboratory develops.">
<section>{entries.map(entry => <article class="log-card"><time>{entry.data.date.toISOString().slice(0,10)} // {entry.data.status.toUpperCase()}</time><h3><a href={`${base}exploration-log/${entry.id}/`}>{entry.data.title}</a></h3><p>{entry.data.description}</p><div class="tags">{entry.data.tags.map(t=><span>{t}</span>)}</div></article>)}</section>
<section class="paper"><p class="eyebrow">FIELD JOURNAL // LONG-FORM DIRECTION</p><h1>One genome does not have only one history.</h1><p>Why different regions of the same genome can point toward different pasts—and why local genealogies change the way we tell evolutionary stories.</p></section>
</PageLayout>